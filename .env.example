# Copy to .env for local development. Never commit .env.
# In Azure these values come from Key Vault (see infra/azure/main.bicep).

LOG_FORMAT=text                 # text | json
LOG_LEVEL=INFO
# REVINTEL_DUCKDB_PATH=output/revintel.duckdb

# --- Snowflake (objects created by sql/00_setup.sql) ---
SNOWFLAKE_ACCOUNT=xy12345.west-europe.azure
SNOWFLAKE_USER=SVC_REVINTEL
# Service auth (prod): PEM private key content. Developers leave this empty and use SSO (externalbrowser).
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=REVINTEL_LOADER
SNOWFLAKE_WAREHOUSE=REVINTEL_WH
SNOWFLAKE_DATABASE=REVINTEL

# --- Azure Data Lake: managed identity via account URL (preferred) ---
AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONNECTION_STRING=   # fallback for local testing with Azurite
AZURE_STORAGE_CONTAINER=revintel

# --- Power BI dataset refresh (service principal) ---
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=

# --- Failure alerts (Slack or Teams incoming webhook) ---
ALERT_WEBHOOK_URL=
