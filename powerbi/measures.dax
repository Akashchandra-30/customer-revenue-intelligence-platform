// =============================================================================
// Customer & Revenue Intelligence - DAX measures
// Model (see DASHBOARD_GUIDE.md):
//   fct_orders, fct_order_items -> dim_customer, dim_product, dim_date
//   customer_ltv, rfm_segments (1:1 with dim_customer), cohort_retention
// dim_date comes from the warehouse (dbt model) - mark it as the date table.
// Put all measures in a dedicated "_Measures" table, grouped in display folders.
// =============================================================================

// ---------- Revenue ------------------------------------------------------------
Total Revenue = SUM ( fct_orders[net_revenue_usd] )

Gross Sales = CALCULATE ( SUM ( fct_orders[gross_amount_usd] ), fct_orders[is_revenue_order] )

Total Discounts = CALCULATE ( SUM ( fct_orders[discount_amount_usd] ), fct_orders[is_revenue_order] )

Discount Rate % = DIVIDE ( [Total Discounts], [Gross Sales] )

Completed Orders = CALCULATE ( COUNTROWS ( fct_orders ), fct_orders[is_revenue_order] )

Average Order Value = DIVIDE ( [Total Revenue], [Completed Orders] )

Refund Rate % =
DIVIDE (
    CALCULATE ( COUNTROWS ( fct_orders ), fct_orders[status] = "refunded" ),
    COUNTROWS ( fct_orders )
)

// ---------- Time intelligence ------------------------------------------------------
Revenue PM = CALCULATE ( [Total Revenue], DATEADD ( dim_date[date_day], -1, MONTH ) )

Revenue MoM % = DIVIDE ( [Total Revenue] - [Revenue PM], [Revenue PM] )

Revenue PY = CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( dim_date[date_day] ) )

Revenue YoY % = DIVIDE ( [Total Revenue] - [Revenue PY], [Revenue PY] )

Revenue YTD = TOTALYTD ( [Total Revenue], dim_date[date_day] )

Revenue Rolling 3M =
CALCULATE (
    [Total Revenue],
    DATESINPERIOD ( dim_date[date_day], MAX ( dim_date[date_day] ), -3, MONTH )
)

Revenue Share % =
DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], ALLSELECTED ( dim_customer ) ) )

// ---------- Customers --------------------------------------------------------------
Active Customers =
CALCULATE ( DISTINCTCOUNT ( fct_orders[customer_id] ), fct_orders[is_revenue_order] )

// First purchase falls in the selected period (date filter applied to dim_customer)
New Customers =
CALCULATE (
    COUNTROWS ( dim_customer ),
    TREATAS ( VALUES ( dim_date[date_day] ), dim_customer[first_order_date] )
)

Returning Customers = [Active Customers] - [New Customers]

Revenue per Customer = DIVIDE ( [Total Revenue], [Active Customers] )

// Customers who bought in the selected period AND in the previous month
Retained Customers MoM =
VAR CurrentBuyers =
    CALCULATETABLE ( VALUES ( fct_orders[customer_id] ), fct_orders[is_revenue_order] )
VAR PriorBuyers =
    CALCULATETABLE (
        VALUES ( fct_orders[customer_id] ),
        fct_orders[is_revenue_order],
        DATEADD ( dim_date[date_day], -1, MONTH )
    )
RETURN
    COUNTROWS ( INTERSECT ( CurrentBuyers, PriorBuyers ) )

Customer Retention Rate MoM =
DIVIDE (
    [Retained Customers MoM],
    CALCULATE ( [Active Customers], DATEADD ( dim_date[date_day], -1, MONTH ) )
)

// ---------- Lifetime value & segmentation ---------------------------------------------
Avg Customer LTV = AVERAGE ( customer_ltv[total_revenue_usd] )

Avg Predicted CLV = AVERAGE ( customer_ltv[predicted_clv_usd] )

Repeat Purchase Rate % =
DIVIDE (
    CALCULATE ( COUNTROWS ( customer_ltv ), customer_ltv[orders] > 1 ),
    COUNTROWS ( customer_ltv )
)

Churned Customers =
CALCULATE ( COUNTROWS ( customer_ltv ), customer_ltv[lifecycle_status] = "Churned" )

Churn Rate % = DIVIDE ( [Churned Customers], COUNTROWS ( customer_ltv ) )

Top 10% Customer Revenue Share =
DIVIDE (
    CALCULATE ( SUM ( customer_ltv[total_revenue_usd] ), customer_ltv[revenue_percentile] >= 0.9 ),
    SUM ( customer_ltv[total_revenue_usd] )
)

Champions Count = CALCULATE ( COUNTROWS ( rfm_segments ), rfm_segments[rfm_segment] = "Champions" )

// ---------- Cohorts --------------------------------------------------------------------
// Matrix: rows = cohort_month, columns = months_since_first
Cohort Retention % =
DIVIDE ( SUM ( cohort_retention[active_customers] ), SUM ( cohort_retention[cohort_customers] ) )

Cohort Cumulative Revenue per Customer = MAX ( cohort_retention[cumulative_revenue_per_customer_usd] )

// ---------- Formatting helpers ----------------------------------------------------------
// Conditional colour for KPI cards: green when growing, red when declining
YoY Colour = IF ( [Revenue YoY %] >= 0, "#16A34A", "#DC2626" )

Last Refreshed = "Data as of " & FORMAT ( MAX ( fct_orders[order_date] ), "dd mmm yyyy" )
